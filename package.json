{
  "name": "edu-watch",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks 2>/dev/null || true",
    "dev": "astro dev",
    "build": "astro build && npx pagefind --site dist",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "check:filter:resemom": "npx tsx scripts/check-resemom-filter.ts",
    "check:filter:kyodo": "npx tsx scripts/check-kyodo-filter.ts",
    "check:filter:kkn": "npx tsx scripts/check-kkn-filter.ts",
    "check:filter": "npm run check:filter:resemom && npm run check:filter:kyodo && npm run check:filter:kkn",
    "check:fetch:oecd": "npx tsx scripts/check-oecd-fetch.ts",
    "check:excluded-ids": "npx tsx scripts/check-excluded-ids.ts",
    "check:membership:nikkyo": "npx tsx scripts/check-nikkyo-membership.ts",
    "check:membership-updates": "npx tsx scripts/check-membership-updates.ts",
    "check:tokens": "npx tsx scripts/check-tokens.ts",
    "check:text": "textlint 'src/content/digests/**/*.md'",
    "check:text:fix": "textlint --fix 'src/content/digests/**/*.md'",
    "check:all": "npm run check:tokens && npm run check && npm run check:text && npm run check:filter && npm run check:excluded-ids",
    "test:ai-summary": "node --test 'scripts/ai-summary/*.test.mjs'",
    "test:hooks": "node scripts/assert-test-files.mjs '.claude/hooks/__tests__/*.test.cjs' && node scripts/assert-test-results.mjs 26 '.claude/hooks/__tests__/*.test.cjs'",
    "test:e2e": "npx playwright test",
    "test:e2e:ui": "npx playwright test --ui",
    "vrt": "npx playwright test --config playwright.vrt.config.ts",
    "og:default": "npx tsx scripts/generate-default-og.ts"
  },
  "dependencies": {
    "@astrojs/react": "^6.0.2",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "astro": "^7.2.0",
    "cheerio": "^1.2.0",
    "isomorphic-dompurify": "^3.22.0",
    "marked": "^18.0.9",
    "pdf-parse": "^2.4.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "rss-parser": "^3.13.0",
    "satori": "^0.29.0",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.2.2",
    "undici": "^8.9.0",
    "vite": "^8.2.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.62.1",
    "pagefind": "^1.5.2",
    "serve": "^14.2.6",
    "textlint": "^15.8.0",
    "textlint-rule-no-mix-dearu-desumasu": "^6.0.4",
    "textlint-rule-preset-ja-spacing": "^3.0.2",
    "textlint-rule-preset-ja-technical-writing": "^12.0.2",
    "textlint-rule-prh": "^6.1.0",
    "tsx": "^4.23.11",
    "typescript": "^5.9.3",
    "wrangler": "^4.118.0"
  },
  "overrides": {
    "@babel/core": "^7.29.6",
    "js-yaml": "^4.3.1",
    "neotraverse": "^1.0.1",
    "fast-uri": "^3.1.5",
    "ip-address": "^10.4.0",
    "undici@^7.0.0": "^7.29.0",
    "yaml": "^2.8.3",
    "hono": "^4.12.34",
    "body-parser": "^2.3.0",
    "brace-expansion@^1.0.0": "^1.1.17",
    "brace-expansion@^5.0.0": "^5.0.9",
    "postcss": "^8.5.25"
  }
}

node_modules
dist
.astro
.DS_Store
*.log
.env
.env.*
test-results
playwright-report
blob-report

# VRT(ADR 0060): ベースラインはコミットせず CI の 2 ビルド差分で都度生成する
vrt/__screenshots__/
dist-pr
dist-main

# OG 画像生成のフォントは scripts/fonts/noto-sans-jp-bold.bin をリポジトリに同梱
# (ADR 0031、Google Fonts / jsDelivr への build-time 依存を排除)。
# その他の binary / 派生フォントは引き続き除外する。
scripts/fonts/*.woff2
scripts/fonts/*.otf
scripts/fonts/*.ttf
!scripts/fonts/noto-sans-jp-bold.bin

# Claude Code の生きたセッション状態(docs/context-management.md 参照)
.claude/state/
.claude/worktrees/
.claude/sessions/

# PoC / 実験用ディレクトリ(原則 git 管理外、PoC 採用時に必要部分のみ src/lib/ へ移管)。
experiments/*

# Local security assessment notes (kept outside the repository)
VULN_ASSESSMENT_*.md
SUPPLY_CHAIN_AUDIT_*.md
NODEJS_AUDIT_RESULT_*.md

# Wrangler の作業ディレクトリ
.wrangler/

    ],
  },
  {
    date: "2026-04-26",
    items: [
      {
        type: "add",
        text: "サイトを公開し、日次の自動収集を稼働開始しました(文部科学省・国立教育政策研究所・OECD Education・教育新聞・日本教育新聞・教育家庭新聞・リセマム の 7 媒体、12:49 / 22:26 JST に更新)",
      },
      {
        type: "update",
        text: "第 2 層を大手紙の教育面から教育専門紙(教育新聞・日本教育新聞・教育家庭新聞・リセマム)へ転換しました",
      },
    ],
  },
  {
    date: "2026-04-24",
    items: [
      {
        type: "add",
        text: "ブランド名「EduWatch JP」とロゴ・アクセント色を採用しました",
      },
    ],
  },
];

const typeLabel: Record<string, { label: string; color: string }> = {
  add: { label: "追加", color: "text-change-add" },
  update: { label: "更新", color: "text-change-update" },
  fix: { label: "修正", color: "text-change-fix" },
  remove: { label: "削除", color: "text-sub" },
};
---

<Layout title="更新履歴 — EduWatch JP">
  <section class="pt-10 sm:pt-14 md:pt-20 lg:pt-28 pb-10 sm:pb-14 md:pb-20 border-b border-line">
    <p class="font-mono text-[10px] uppercase tracking-widest text-accent">
      Changelog
    </p>
    <h1
      class="mt-5 font-black text-4xl sm:text-5xl md:text-6xl lg:text-7xl leading-[1.15] tracking-tight"
    >
      更新履歴
    </h1>
    <p class="mt-6 text-sub text-sm sm:text-base leading-loose max-w-2xl">
      サイト機能・データの追加・修正を時系列で記録しています。
    </p>
  </section>

  <section class="pb-24">
    {
      entries.map((entry) => (
        <div class="border-t border-line py-10 space-y-4">
          <div class="font-mono text-sm text-accent">
            {entry.date}
          </div>
          <ul class="space-y-3">
            {entry.items.map((item) => {
              const t = typeLabel[item.type] ?? typeLabel.add;
              return (
                <li class="flex gap-3 items-baseline text-sm leading-relaxed">
                  <span
                    class={`font-mono text-xs uppercase tracking-widest shrink-0 ${t.color}`}
                  >
                    {t.label}
                  </span>
                  <span>
                    {item.text}
                    {item.links && (
                      <span class="mt-1.5 flex flex-wrap gap-x-4 gap-y-1 text-xs">
                        {item.links.map((l) => (
                          <a href={l.href} class="link-underline">
                            {l.label} <span aria-hidden="true">→</span>
                          </a>
                        ))}
                      </span>
                    )}
                  </span>
                </li>
              );
            })}
          </ul>
        </div>
      ))
    }
    <div class="border-t border-line"></div>
  </section>
</Layout>

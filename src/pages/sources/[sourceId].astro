---
import Layout from "../../layouts/Layout.astro";
import ArticleCard from "../../components/ArticleCard.astro";
import { SOURCE_META, getSourceMeta } from "../../lib/source-meta.ts";
import {
  getArticlesBySource,
  groupByDate,
  formatDayShort,
} from "../../lib/articles.ts";

export function getStaticPaths() {
  return Object.values(SOURCE_META).map((s) => ({ params: { sourceId: s.sourceId } }));
}

const { sourceId } = Astro.params as { sourceId: string };
const meta = getSourceMeta(sourceId);
if (!meta) {
  throw new Error(`Unknown sourceId: ${sourceId}`);
}
const articles = getArticlesBySource(sourceId);
const groups = groupByDate(articles);
const tierLabel =
  meta.layer === 1
    ? "Tier 1 — 一次情報"
    : meta.layer === 2
      ? "Tier 2 — 教育専門紙・通信社"
      : "Tier 3 — 参考のみ";
---

<Layout
  title={`${meta.displayName} — EduWatch JP`}
  description={`${meta.displayName} の教育関連記事 ${articles.length} 件。EduWatch JP が一次情報から日次で自動収集。`}
>
  <section class="pt-10 sm:pt-14 md:pt-20 lg:pt-28 pb-10 sm:pb-14 md:pb-20 border-b border-line">
    <p class="font-mono text-[10px] uppercase tracking-widest text-accent">
      Source · {tierLabel}
    </p>
    <h1 class="mt-5 font-black text-4xl sm:text-5xl md:text-6xl lg:text-7xl leading-[1.15] tracking-tight">
      <span class="text-accent">{meta.displayName}</span>
    </h1>
    <p class="mt-3 text-sub text-xs font-mono tracking-wide">
      {articles.length} 件
      <a
        href={meta.homeUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="ml-3 link-underline"
      >公式サイト ↗</a>
    </p>
    <p class="mt-4 text-sub text-sm leading-relaxed">
      <a href="/sources/" class="link-underline">← 媒体一覧</a>
      <span class="ml-3"><a href="/" class="link-underline">トップ</a></span>
    </p>
  </section>

  {
    groups.length === 0 ? (
      <p class="py-20 text-center text-sub text-sm">
        この媒体の記事はまだありません。
      </p>
    ) : (
      <div class="divide-y divide-line">
        {groups.map((group) => (
          <section class="py-8 sm:py-10">
            <h2 class="mb-4 sm:mb-6 font-mono text-xs uppercase tracking-widest text-sub">
              <time datetime={group.date}>{formatDayShort(group.date)}</time>
              <span class="ml-3 text-sub">{group.articles.length} 件</span>
            </h2>
            <div>
              {group.articles.map((article) => (
                <ArticleCard article={article} />
              ))}
            </div>
          </section>
        ))}
      </div>
    )
  }
</Layout>

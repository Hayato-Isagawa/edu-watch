// Cloudflare Workers (static assets) のデプロイ設定。
//
// Cloudflare Pages から移行した。Pages は今後もサポートされるが、投資・最適化・
// 機能追加はすべて Workers に向けると公式が明言しているため。
// https://developers.cloudflare.com/workers/static-assets/migration-guides/migrate-from-pages/
//
// このサイトは純粋な静的出力(SSR アダプタ・Pages Functions・_worker.js を持たない)
// なので、assets だけを指定する「assets-only」構成になる。main は不要。
//
// custom domain (news.edu-evidence.org) を routes に持たせている。移行直後は
// ホスト名がまだ Pages 側に紐づいており、二重に要求するとデプロイが失敗するため
// 空にしていた。2026-08-06 に Pages プロジェクトを削除したので解禁した。
// これで deploy 時にドメインの紐づけまで wrangler が面倒を見る。
{
  "name": "edu-watch",
  "compatibility_date": "2026-08-05",
  // *.workers.dev は公開しない。カスタムドメインと同じ内容が別ホストでも
  // 配信され、canonical タグ頼みの重複コンテンツになるため(okinawa と同方針)。
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    // 未知のパスは 404.html を返す。Pages の既定挙動に合わせる。
    "not_found_handling": "404-page"
  },
  "routes": [{ "pattern": "news.edu-evidence.org", "custom_domain": true }]
}
